NODE_ENV=development
PORT=3001

# New Supabase Postgres connection. Use a session pooler for an IPv4-only
# persistent host, or a transaction pooler for serverless/auto-scaling hosts.
DATABASE_URL=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGNED_URL_TTL_SECONDS=300

# AI provider
GEMINI_API_KEY=
GEMINI_MOCK=true

# Production frontend and CORS
CORS_ORIGIN=http://localhost:3000

# Custom Firebase authentication emails sent through the Resend HTTPS API.
RESEND_API_KEY=
AUTH_EMAIL_FRONTEND_URL=http://localhost:3000
REGISTRATION_EMAIL_FROM=registration@documind.icu
RESET_PASSWORD_EMAIL_FROM=reset-password@documind.icu

# SePay
SEPAY_ENABLED=false
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_WEBHOOK_API_KEY=
SEPAY_FRONTEND_URL=http://localhost:3000
SEPAY_STUDENT_PRICE_VND=
SEPAY_PRO_PRICE_VND=

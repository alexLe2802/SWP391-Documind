{
  "name": "ai-study-hub-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Study Hub NestJS backend",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "prebuild": "node scripts/check-node-version.cjs && prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,mjs}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,mjs}\" \"docs/**/*.md\"",
    "start": "nest start",
    "prestart:dev": "node scripts/check-node-version.cjs && node -e \"require('fs').rmSync('tsconfig.build.tsbuildinfo',{force:true})\"",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prelint": "node scripts/check-node-version.cjs && prisma generate",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "pretest": "node scripts/check-node-version.cjs && prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "pretest:e2e": "node scripts/check-node-version.cjs && prisma generate",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "documents:reindex": "ts-node scripts/reindex-documents.ts",
    "db:backup": "node scripts/database-maintenance.mjs backup",
    "db:restore": "node scripts/database-maintenance.mjs restore",
    "test:db-tools": "node --test scripts/database-maintenance.test.mjs",
    "test:e2e:srs": "jest --config ./test/jest-e2e.json --runInBand core-demo-flow.e2e-spec.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.0.0",
    "joi": "^18.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sepay-pg-node": "^1.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.26",
    "@sinonjs/commons": "^4.0.0-alpha.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}

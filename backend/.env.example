NODE_ENV=development
PORT=3001

# New Supabase Postgres connection. Use a session pooler for an IPv4-only
# persistent host, or a transaction pooler for serverless/auto-scaling hosts.
DATABASE_URL=
# Direct Supabase connection used only by scheduled pg_dump jobs. Do not use
# the transaction pooler URL for backups.
BACKUP_DATABASE_URL=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGNED_URL_TTL_SECONDS=300

# AI provider
GEMINI_API_KEY=
# Mock responses are allowed only outside production. Render production must
# explicitly set GEMINI_MOCK=false and provide GEMINI_API_KEY or GEMINI_API_KEYS.
GEMINI_MOCK=true

# Local authentication bypass. Production startup rejects true.
MOCK_AUTH=false

# OCR fallback for scanned/image-only PDFs. Without a LlamaCloud key, these
# documents cannot be made searchable by the local PDF text extractor.
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_PREMIUM_MODE=false
OCR_MAX_PAGES=20
EXTRACTION_TIMEOUT_MS=240000
EXTRACTION_QUEUE_CONCURRENCY=2
# A PROCESSING job older than this lease is reclaimed after a restart.
EXTRACTION_LEASE_TIMEOUT_MS=600000

# Comma-separated terms that send public documents to manual moderation.
# When omitted, the built-in Vietnamese/English safety keyword list is used.
MODERATION_KEYWORDS=

# Production frontend and CORS
CORS_ORIGIN=http://localhost:3000

# Custom Firebase authentication emails sent through the Resend HTTPS API.
RESEND_API_KEY=
AUTH_EMAIL_FRONTEND_URL=http://localhost:3000
REGISTRATION_EMAIL_FROM=registration@documind.icu
RESET_PASSWORD_EMAIL_FROM=reset-password@documind.icu

# SePay
SEPAY_ENABLED=false
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_WEBHOOK_API_KEY=
SEPAY_FRONTEND_URL=http://localhost:3000
SEPAY_STUDENT_PRICE_VND=149000
SEPAY_PRO_PRICE_VND=349000
